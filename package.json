    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.37.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "webtorrent": "^2.8.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
