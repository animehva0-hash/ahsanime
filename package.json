{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "webtorrent": "node webtorrent-server.js",
    "build": "next build",
    "build:cloudflare": "npm run build && opennextjs-cloudflare build --skipWranglerConfigCheck",
    "preview": "npm run build:cloudflare && wrangler pages dev .open-next/assets",
